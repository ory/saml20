{
  "name": "@boxyhq/saml20",
  "version": "3.0.0",
  "description": "SAML 2.0 token parser for Node.js",
  "keywords": [
    "SAML 2.0",
    "Token Parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ory/saml20.git"
  },
  "license": "MIT",
  "author": "Leandro Boffi (me@leandrob.com)",
  "contributors": [
    {
      "name": "Phillip Son",
      "email": "philson3@gmail.com"
    },
    {
      "name": "Deepak Prabhakara",
      "email": "deepak.prabhakara@ory.sh"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sort": "npx sort-package-json",
    "test": "node --import tsx --test --experimental-test-isolation=none --experimental-test-coverage --test-coverage-include=\"lib/**\" \"test/lib/**/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublishOnly": "npm run build",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "release": "git checkout release && git merge origin/main && release-it && git checkout main && git merge origin/release && git push origin main"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "xml-crypto": "6.4.0",
    "xml-encryption": "6.0.2",
    "xmlbuilder2": "4.0.3",
    "xpath": "0.0.36"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/xml-encryption": "1.2.4",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "release-it": {
      "undici": ">=6.24.0"
    },
    "unicorn-magic": "0.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
